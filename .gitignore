node_modules/
.next/
out/
next-env.d.ts
.env
.env.local
.DS_Store
tsconfig.tsbuildinfo

# The merge-only lines file lives on the data branch and nowhere else. A local
# `npm run lines` writes one here; committing it to main would create a second,
# stale copy of the only record of the season closing lines.
public/lines.json

# The data-branch worktree the Action checks out.
.data/

# The full-size character renders the kart icons are cropped from: 12MB of
# source for 92KB of assets. `scripts/build-karts.mjs` reads them from here and
# writes public/karts/, which is what ships; keeping the sources out of the
# repo keeps 12MB out of every clone and off every deploy. They are one-off
# inputs rather than something the build regenerates, so nothing breaks without
# them - only re-cropping does.
assets/karts/
